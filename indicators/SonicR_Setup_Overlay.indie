# indie:lang_version = 5
import math
from indie import indicator, param, plot, color, Var, MainContext, sec_context, TimeFrame
from indie.algorithms import Ema, Rsi, Wma, Atr
@sec_context
def HtfPulse(self) -> tuple[float, float, float, float]:
    r = Rsi.new(self.close, 14)
    w = Wma.new(r, 45)
    return r[1], Ema.new(r, 9)[1], w[1], w[1] - w[2]
@indicator('Sonic R + RSI Pulse Overlay', overlay_main_pane=True)
@param.bool('strict_htf', default=False, title='Strict H4 & H1 Full Alignment')
@param.float('min_slp', default=0.05, min=0.0, title='Min H4/H1 WMA45 Slope')
@param.float('tangle_sp', default=2.5, min=0.5, title='Min H4/H1 3-Line Spread')
@param.float('w45_tol', default=2.0, min=0.5, title='M15 WMA45 Touch Tolerance')
@param.int('d_max', default=24, min=6, max=50, title='M5 Pivot Max Lookback')
@param.float('db_tol', default=3.0, min=0.5, title='M5 Double Bottom/Top Tol')
@param.float('db_prom', default=4.0, min=1.0, title='M5 Double Bottom/Top Prominence')
@param.bool('use_e200', default=False, title='Require Price Beyond EMA 200')
@param.int('trig_mode', default=0, min=0, max=1, title='Sonic Trigger (0=Bounce, 1=Break)')
@param.float('rnd_step', default=10.0, min=1.0, title='Round Number Step (XAUUSD)')
@plot.line('dh', title='Dragon High (EMA 34)', color=color.rgba(33, 150, 243, 0.55), line_width=1)
@plot.line('dc', title='Dragon Close (EMA 34)', color=color.rgba(33, 150, 243, 0.95), line_width=2)
@plot.line('dl', title='Dragon Low (EMA 34)', color=color.rgba(33, 150, 243, 0.55), line_width=1)
@plot.line('e89', title='Trend Line (EMA 89)', color=color.rgba(255, 179, 0, 0.95), line_width=2)
@plot.line('e200', title='Macro EMA 200 (Ref)', color=color.rgba(158, 158, 158, 0.70), line_width=1)
@plot.line('s_hi', title='Ref Swing High', color=color.rgba(239, 83, 80, 0.50), line_width=1)
@plot.line('s_lo', title='Ref Swing Low', color=color.rgba(38, 166, 154, 0.50), line_width=1)
@plot.line('r_hi', title='Upper Round Level', color=color.rgba(189, 189, 189, 0.35), line_width=1)
@plot.line('r_lo', title='Lower Round Level', color=color.rgba(189, 189, 189, 0.35), line_width=1)
@plot.marker(title='Potential Bull Setup', color=color.rgba(0, 230, 118, 1.0), style=plot.marker_style.LABEL, position=plot.marker_position.BELOW, size=3)
@plot.marker(title='Potential Bear Setup', color=color.rgba(255, 82, 82, 1.0), style=plot.marker_style.LABEL, position=plot.marker_position.ABOVE, size=3)
class Main(MainContext):
    def __init__(self, strict_htf: bool, min_slp: float, tangle_sp: float, w45_tol: float, d_max: int, db_tol: float, db_prom: float, use_e200: bool, trig_mode: int, rnd_step: float):
        self.strict_htf = strict_htf; self.min_slp = min_slp; self.tangle_sp = tangle_sp; self.w45_tol = w45_tol
        self.d_max = d_max; self.db_tol = db_tol; self.db_prom = db_prom; self.use_e200 = use_e200; self.trig_mode = trig_mode; self.rnd_step = rnd_step
        self.r4, self.e4, self.w4, self.s4 = self.calc_on(HtfPulse, time_frame=TimeFrame.from_str('4h'))
        self.r1, self.e1, self.w1, self.s1 = self.calc_on(HtfPulse, time_frame=TimeFrame.from_str('1h'))
        self.r15, self.e15, self.w15, self.s15 = self.calc_on(HtfPulse, time_frame=TimeFrame.from_str('15m'))
    def calc(self):
        lock_u_bar = Var[int].new(-1); lock_d_bar = Var[int].new(-1)
        lock_ph = Var[float].new(math.nan); lock_pl = Var[float].new(math.nan)
        dh = Ema.new(self.high, 34); dc = Ema.new(self.close, 34); dl = Ema.new(self.low, 34)
        e89 = Ema.new(self.close, 89); e200 = Ema.new(self.close, 200); atr = Atr.new(14); r = Rsi.new(self.close, 14); e9 = Ema.new(r, 9)
        has_c1 = not math.isnan(self.close[1])
        c_lo = (math.floor(self.close[0] / self.rnd_step) * self.rnd_step) if not math.isnan(self.close[0]) else math.nan
        same_step = has_c1 and (c_lo == math.floor(self.close[1] / self.rnd_step) * self.rnd_step)
        if math.isnan(self.w4[1]) or math.isnan(self.w1[1]) or math.isnan(self.w15[4]) or math.isnan(e200[1]) or math.isnan(r[self.d_max + 9]):
            return dh[0], dc[0], dl[0], e89[0], e200[0], math.nan, math.nan, ((c_lo + self.rnd_step) if same_step else math.nan), (c_lo if same_step else math.nan), plot.Marker(math.nan, text='▲', offset=-1), plot.Marker(math.nan, text='▼', offset=-1)
        sp4 = max(self.r4[1], max(self.e4[1], self.w4[1])) - min(self.r4[1], min(self.e4[1], self.w4[1]))
        sp1 = max(self.r1[1], max(self.e1[1], self.w1[1])) - min(self.r1[1], min(self.e1[1], self.w1[1]))
        htf_up = (self.r4[1] > self.w4[1] and self.e4[1] > self.w4[1] and self.s4[1] >= self.min_slp and sp4 >= self.tangle_sp) and (((self.r1[1] > self.w1[1]) if self.strict_htf else True) and self.e1[1] >= self.w1[1] and self.s1[1] >= self.min_slp and sp1 >= self.tangle_sp)
        htf_dn = (self.r4[1] < self.w4[1] and self.e4[1] < self.w4[1] and self.s4[1] <= -self.min_slp and sp4 >= self.tangle_sp) and (((self.r1[1] < self.w1[1]) if self.strict_htf else True) and self.e1[1] <= self.w1[1] and self.s1[1] <= -self.min_slp and sp1 >= self.tangle_sp)
        m15_up = (((40.0 <= self.r15[1] and self.r15[1] <= 50.0) or abs(self.r15[1] - self.w15[1]) <= self.w45_tol or (40.0 <= self.r15[4] and self.r15[4] <= 50.0) or abs(self.r15[4] - self.w15[4]) <= self.w45_tol) and (38.0 <= self.r15[1] and self.r15[1] < 70.0))
        m15_dn = (((50.0 <= self.r15[1] and self.r15[1] <= 60.0) or abs(self.r15[1] - self.w15[1]) <= self.w45_tol or (50.0 <= self.r15[4] and self.r15[4] <= 60.0) or abs(self.r15[4] - self.w15[4]) <= self.w45_tol) and (30.0 < self.r15[1] and self.r15[1] <= 62.0))
        if dc[1] < e89[1]:
            lock_ph.set(math.nan)
        if dc[1] > e89[1]:
            lock_pl.set(math.nan)
        kh = 0; kl = 0; kl_o = 0; kh_o = 0; k_hl = 2; k_lh = 2; tch_u = 0; tch_d = 0; rph = 0; rpl = 0
        kl2 = 0; kl1 = 0; kh2 = 0; kh1 = 0; mid_hi = -1.0; mid_lo = 101.0; ul = False; uh = False
        inv_u = (self.close[1] < e89[1]); inv_d = (self.close[1] > e89[1])
        for k in range(2, self.d_max + 8):
            is_ph = self.high[k] > self.high[k - 1] and self.high[k] >= self.high[k + 1] and self.high[k] > self.high[k + 2]
            is_pl = self.low[k] < self.low[k - 1] and self.low[k] <= self.low[k + 1] and self.low[k] < self.low[k + 2]
            if is_ph and rph == 0:
                rph = k
            if is_pl and rpl == 0:
                rpl = k
            if kh == 0 and k >= 3 and is_ph and self.high[k] > dh[k] and (self.close[k] > dh[k] or self.close[k + 1] > dh[k + 1]):
                kh = k
            elif kh == 0:
                k_hl = k if self.low[k] <= self.low[k_hl] else k_hl
                tch_u = k if (self.low[k] <= dh[k] and tch_u == 0) else tch_u
                inv_u = inv_u or (self.close[k] < e89[k])
            elif kl_o == 0 and is_pl:
                kl_o = k
            if kl == 0 and k >= 3 and is_pl and self.low[k] < dl[k] and (self.close[k] < dl[k] or self.close[k + 1] < dl[k + 1]):
                kl = k
            elif kl == 0:
                k_lh = k if self.high[k] >= self.high[k_lh] else k_lh
                tch_d = k if (self.high[k] >= dl[k] and tch_d == 0) else tch_d
                inv_d = inv_d or (self.close[k] > e89[k])
            elif kh_o == 0 and is_ph:
                kh_o = k
            r_pl = r[k] < r[k - 1] and r[k] <= r[k + 1] and r[k] < r[k + 2]
            if kl2 == 0:
                kl2 = k if (r_pl and k <= 7 and not ul) else 0
                ul = ul or (r[k] > e9[k] and r[k + 1] <= e9[k + 1])
            elif kl1 == 0:
                if r_pl:
                    kl1 = k
                else:
                    mid_hi = max(mid_hi, r[k])
            r_ph = r[k] > r[k - 1] and r[k] >= r[k + 1] and r[k] > r[k + 2]
            if kh2 == 0:
                kh2 = k if (r_ph and k <= 7 and not uh) else 0
                uh = uh or (r[k] < e9[k] and r[k + 1] >= e9[k + 1])
            elif kh1 == 0:
                if r_ph:
                    kh1 = k
                else:
                    mid_lo = min(mid_lo, r[k])
        v_lo = kl1 > 0 and 3 <= (kl1 - kl2) and (kl1 - kl2) <= self.d_max and r[1] >= r[kl2]
        v_hi = kh1 > 0 and 3 <= (kh1 - kh2) and (kh1 - kh2) <= self.d_max and r[1] <= r[kh2]
        m5_bull = v_lo and ((min(self.low[kl2], self.low[kl2 + 1]) < min(self.low[kl1], self.low[kl1 + 1]) and r[kl2] > r[kl1]) or (min(self.low[kl2], self.low[kl2 + 1]) > min(self.low[kl1], self.low[kl1 + 1]) and r[kl2] < r[kl1]) or (abs(r[kl2] - r[kl1]) <= self.db_tol and (mid_hi - max(r[kl2], r[kl1])) >= self.db_prom)) and r[1] > e9[1] and r[2] <= e9[2]
        m5_bear = v_hi and ((max(self.high[kh2], self.high[kh2 + 1]) > max(self.high[kh1], self.high[kh1 + 1]) and r[kh2] < r[kh1]) or (max(self.high[kh2], self.high[kh2 + 1]) < max(self.high[kh1], self.high[kh1 + 1]) and r[kh2] > r[kh1]) or (abs(r[kh2] - r[kh1]) <= self.db_tol and (min(r[kh2], r[kh1]) - mid_lo) >= self.db_prom)) and r[1] < e9[1] and r[2] >= e9[2]
        ph = self.high[kh] if kh > 0 else math.nan
        pl = self.low[kl] if kl > 0 else math.nan
        w_up = (kl_o > kh and kh > k_hl and k_hl >= 2 and 2 <= tch_u and tch_u < kh and not inv_u and self.low[1] >= self.low[k_hl] and self.low[k_hl] > self.low[kl_o])
        w_dn = (kh_o > kl and kl > k_lh and k_lh >= 2 and 2 <= tch_d and tch_d < kl and not inv_d and self.high[1] <= self.high[k_lh] and self.high[k_lh] < self.high[kh_o])
        ev_up = (self.close[1] > dh[1] and self.close[1] > self.open[1] and (self.close[2] <= dh[2] or self.low[2] <= dh[2])) if self.trig_mode == 0 else (self.close[1] > ph and self.close[2] <= ph)
        ev_dn = (self.close[1] < dl[1] and self.close[1] < self.open[1] and (self.close[2] >= dl[2] or self.high[2] >= dl[2])) if self.trig_mode == 0 else (self.close[1] < pl and self.close[2] >= pl)
        cyc_u = (self.bar_index - kh > lock_u_bar.get()) and (math.isnan(lock_ph.get()) or ph >= lock_ph.get())
        cyc_d = (self.bar_index - kl > lock_d_bar.get()) and (math.isnan(lock_pl.get()) or pl <= lock_pl.get())
        fire_up = htf_up and m15_up and cyc_u and dc[1] > e89[1] and dc[1] > dc[2] and (not self.use_e200 or self.close[1] > e200[1]) and w_up and ev_up and m5_bull
        fire_dn = htf_dn and m15_dn and cyc_d and dc[1] < e89[1] and dc[1] < dc[2] and (not self.use_e200 or self.close[1] < e200[1]) and w_dn and ev_dn and m5_bear
        if fire_up:
            lock_u_bar.set(self.bar_index)
            lock_ph.set(ph)
        if fire_dn:
            lock_d_bar.set(self.bar_index)
            lock_pl.set(pl)
        return dh[0], dc[0], dl[0], e89[0], e200[0], (self.high[rph] if rph > 2 else math.nan), (self.low[rpl] if rpl > 2 else math.nan), ((c_lo + self.rnd_step) if same_step else math.nan), (c_lo if same_step else math.nan), plot.Marker((self.low[1] - atr[1] * 0.25) if fire_up else math.nan, text='▲', offset=-1), plot.Marker((self.high[1] + atr[1] * 0.25) if fire_dn else math.nan, text='▼', offset=-1)
