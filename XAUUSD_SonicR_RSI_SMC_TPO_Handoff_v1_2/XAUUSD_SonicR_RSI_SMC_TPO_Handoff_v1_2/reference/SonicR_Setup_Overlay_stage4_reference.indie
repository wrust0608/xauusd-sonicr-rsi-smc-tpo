# indie:lang_version = 5
import math
from indie import indicator, param, plot, color, MainContext, sec_context, TimeFrame
from indie.algorithms import Ema, Rsi, Wma, Atr
@sec_context
def HtfPulse(self) -> tuple[float, float, float, float]:
    r = Rsi.new(self.close, 14)
    e, w = Ema.new(r, 9), Wma.new(r, 45)
    return r[1], e[1], w[1], w[1] - w[2]
@indicator('Sonic R + RSI Pulse Overlay', overlay_main_pane=True)
@param.bool('strict_htf', default=False, title='Strict H4 & H1 Full Alignment')
@param.float('min_slp', default=0.05, min=0.0, title='Min H4/H1 WMA45 Slope')
@param.float('tangle_sp', default=2.5, min=0.5, title='Min H4/H1 3-Line Spread')
@param.float('w45_tol', default=2.0, min=0.5, title='M15 WMA45 Touch Tolerance')
@param.int('d_max', default=24, min=6, max=50, title='M5 Pivot Max Lookback')
@param.float('db_tol', default=3.0, min=0.5, title='M5 Double Bottom/Top Tol')
@param.float('db_prom', default=4.0, min=1.0, title='M5 Double Bottom/Top Prominence')
@param.bool('use_e200', default=False, title='Require Price Beyond EMA 200')
@param.int('trig_mode', default=0, min=0, max=1, title='Sonic Trigger (0=Bounce, 1=Break)')
@param.float('rnd_step', default=10.0, min=1.0, title='Round Number Step (XAUUSD)')
@plot.line('dh', title='Dragon High (EMA 34)', color=color.rgba(33, 150, 243, 0.55), line_width=1)
@plot.line('dc', title='Dragon Close (EMA 34)', color=color.rgba(33, 150, 243, 0.95), line_width=2)
@plot.line('dl', title='Dragon Low (EMA 34)', color=color.rgba(33, 150, 243, 0.55), line_width=1)
@plot.line('e89', title='Trend Line (EMA 89)', color=color.rgba(255, 179, 0, 0.95), line_width=2)
@plot.line('e200', title='Macro EMA 200 (Ref)', color=color.rgba(158, 158, 158, 0.70), line_width=1)
@plot.line('s_hi', title='Ref Swing High', color=color.rgba(239, 83, 80, 0.50), line_width=1)
@plot.line('s_lo', title='Ref Swing Low', color=color.rgba(38, 166, 154, 0.50), line_width=1)
@plot.line('r_hi', title='Upper Round Level', color=color.rgba(189, 189, 189, 0.35), line_width=1)
@plot.line('r_lo', title='Lower Round Level', color=color.rgba(189, 189, 189, 0.35), line_width=1)
@plot.marker(title='Potential Bull Setup', color=color.rgb(0, 230, 118), style=plot.marker_style.LABEL, position=plot.marker_position.BELOW, size=3)
@plot.marker(title='Potential Bear Setup', color=color.rgb(255, 82, 82), style=plot.marker_style.LABEL, position=plot.marker_position.ABOVE, size=3)
class Main(MainContext):
    def __init__(self, strict_htf: bool, min_slp: float, tangle_sp: float, w45_tol: float, d_max: int, db_tol: float, db_prom: float, use_e200: bool, trig_mode: int, rnd_step: float):
        self.strict_htf, self.min_slp, self.tangle_sp, self.w45_tol = strict_htf, min_slp, tangle_sp, w45_tol
        self.d_max, self.db_tol, self.db_prom, self.use_e200, self.trig_mode, self.rnd_step = d_max, db_tol, db_prom, use_e200, trig_mode, rnd_step
        self.r4, self.e4, self.w4, self.s4 = self.calc_on(HtfPulse, time_frame=TimeFrame.from_str('4h'))
        self.r1, self.e1, self.w1, self.s1 = self.calc_on(HtfPulse, time_frame=TimeFrame.from_str('1h'))
        self.r15, self.e15, self.w15, self.s15 = self.calc_on(HtfPulse, time_frame=TimeFrame.from_str('15m'))
        self.lock_u_bar, self.lock_d_bar, self.lock_ph, self.lock_pl = -1, -1, math.nan, math.nan
    def calc(self):
        dh, dc, dl = Ema.new(self.high, 34), Ema.new(self.close, 34), Ema.new(self.low, 34)
        e89, e200, atr = Ema.new(self.close, 89), Ema.new(self.close, 200), Atr.new(14)
        r = Rsi.new(self.close, 14)
        e9, w45 = Ema.new(r, 9), Wma.new(r, 45)
        c_lo = math.floor(self.close[0] / self.rnd_step) * self.rnd_step
        same_step = (c_lo == math.floor(self.close[1] / self.rnd_step) * self.rnd_step)
        rnd_l, rnd_h = (c_lo if same_step else math.nan), ((c_lo + self.rnd_step) if same_step else math.nan)
        if math.isnan(self.w4[1]) or math.isnan(self.w1[1]) or math.isnan(self.w15[4]) or math.isnan(e200[1]) or math.isnan(r[self.d_max + 9]):
            return dh[0], dc[0], dl[0], e89[0], e200[0], math.nan, math.nan, rnd_h, rnd_l, plot.Marker(math.nan, text='▲', offset=-1), plot.Marker(math.nan, text='▼', offset=-1)
        sp4 = max(self.r4[1], max(self.e4[1], self.w4[1])) - min(self.r4[1], min(self.e4[1], self.w4[1]))
        sp1 = max(self.r1[1], max(self.e1[1], self.w1[1])) - min(self.r1[1], min(self.e1[1], self.w1[1]))
        b4_up = self.r4[1] > self.w4[1] and self.e4[1] > self.w4[1] and self.s4[1] >= self.min_slp and sp4 >= self.tangle_sp
        b4_dn = self.r4[1] < self.w4[1] and self.e4[1] < self.w4[1] and self.s4[1] <= -self.min_slp and sp4 >= self.tangle_sp
        b1_up = ((self.r1[1] > self.w1[1]) if self.strict_htf else True) and self.e1[1] >= self.w1[1] and self.s1[1] >= self.min_slp and sp1 >= self.tangle_sp
        b1_dn = ((self.r1[1] < self.w1[1]) if self.strict_htf else True) and self.e1[1] <= self.w1[1] and self.s1[1] <= -self.min_slp and sp1 >= self.tangle_sp
        m15_up = ((40.0 <= self.r15[1] <= 50.0) or abs(self.r15[1] - self.w15[1]) <= self.w45_tol or (40.0 <= self.r15[4] <= 50.0) or abs(self.r15[4] - self.w15[4]) <= self.w45_tol) and (38.0 <= self.r15[1] < 70.0)
        m15_dn = ((50.0 <= self.r15[1] <= 60.0) or abs(self.r15[1] - self.w15[1]) <= self.w45_tol or (50.0 <= self.r15[4] <= 60.0) or abs(self.r15[4] - self.w15[4]) <= self.w45_tol) and (30.0 < self.r15[1] <= 62.0)
        self.lock_ph = math.nan if (dc[1] < e89[1]) else self.lock_ph
        self.lock_pl = math.nan if (dc[1] > e89[1]) else self.lock_pl
        ph, kh, pl_orig, kl_orig, p_hl, k_hl, k_tch_up, ref_ph, k_rph = math.nan, 0, math.nan, 0, self.low[2], 2, 0, math.nan, 0
        pl, kl, ph_orig, kh_orig, p_lh, k_lh, k_tch_dn, ref_pl, k_rpl = math.nan, 0, math.nan, 0, self.high[2], 2, 0, math.nan, 0
        inv_up, inv_dn = (self.close[1] < e89[1]), (self.close[1] > e89[1])
        rl2, pl_2, kl2_r, rl1, pl_1, kl1_r, mid_hi, used_l = math.nan, math.nan, 0, math.nan, math.nan, 0, -1.0, False
        rh2, ph_2, kh2_r, rh1, ph_1, kh1_r, mid_lo, used_h = math.nan, math.nan, 0, math.nan, math.nan, 0, 101.0, False
        for k in range(2, self.d_max + 8):
            is_ph = self.high[k] > self.high[k - 1] and self.high[k] >= self.high[k + 1] and self.high[k] > self.high[k + 2]
            is_pl = self.low[k] < self.low[k - 1] and self.low[k] <= self.low[k + 1] and self.low[k] < self.low[k + 2]
            ref_ph, k_rph = (self.high[k], k) if (is_ph and math.isnan(ref_ph)) else (ref_ph, k_rph)
            ref_pl, k_rpl = (self.low[k], k) if (is_pl and math.isnan(ref_pl)) else (ref_pl, k_rpl)
            if kh == 0:
                if k >= 3 and is_ph and self.high[k] > dh[k] and (self.close[k] > dh[k] or self.close[k + 1] > dh[k + 1]):
                    ph, kh = self.high[k], k
                else:
                    p_hl, k_hl = (self.low[k], k) if self.low[k] <= p_hl else (p_hl, k_hl)
                    k_tch_up, inv_up = (k if (self.low[k] <= dh[k] and k_tch_up == 0) else k_tch_up), (inv_up or self.close[k] < e89[k])
            elif kl_orig == 0 and is_pl:
                pl_orig, kl_orig = self.low[k], k
            if kl == 0:
                if k >= 3 and is_pl and self.low[k] < dl[k] and (self.close[k] < dl[k] or self.close[k + 1] < dl[k + 1]):
                    pl, kl = self.low[k], k
                else:
                    p_lh, k_lh = (self.high[k], k) if self.high[k] >= p_lh else (p_lh, k_lh)
                    k_tch_dn, inv_dn = (k if (self.high[k] >= dl[k] and k_tch_dn == 0) else k_tch_dn), (inv_dn or self.close[k] > e89[k])
            elif kh_orig == 0 and is_ph:
                ph_orig, kh_orig = self.high[k], k
            r_pl = r[k] < r[k - 1] and r[k] <= r[k + 1] and r[k] < r[k + 2]
            if math.isnan(rl2):
                if r_pl and k <= 7 and not used_l:
                    rl2, pl_2, kl2_r = r[k], min(self.low[k], self.low[k + 1]), k
                used_l = True if (r[k] > e9[k] and r[k + 1] <= e9[k + 1]) else used_l
            elif math.isnan(rl1):
                if r_pl:
                    rl1, pl_1, kl1_r = r[k], min(self.low[k], self.low[k + 1]), k
                else:
                    mid_hi = max(mid_hi, r[k])
            r_ph = r[k] > r[k - 1] and r[k] >= r[k + 1] and r[k] > r[k + 2]
            if math.isnan(rh2):
                if r_ph and k <= 7 and not used_h:
                    rh2, ph_2, kh2_r = r[k], max(self.high[k], self.high[k + 1]), k
                used_h = True if (r[k] < e9[k] and r[k + 1] >= e9[k + 1]) else used_h
            elif math.isnan(rh1):
                if r_ph:
                    rh1, ph_1, kh1_r = r[k], max(self.high[k], self.high[k + 1]), k
                else:
                    mid_lo = min(mid_lo, r[k])
        v_lo, v_hi = (not math.isnan(rl1) and 3 <= (kl1_r - kl2_r) <= self.d_max and r[1] >= rl2), (not math.isnan(rh1) and 3 <= (kh1_r - kh2_r) <= self.d_max and r[1] <= rh2)
        reg_bull, hid_bull, db_bull = (v_lo and pl_2 < pl_1 and rl2 > rl1), (v_lo and pl_2 > pl_1 and rl2 < rl1), (v_lo and abs(rl2 - rl1) <= self.db_tol and (mid_hi - max(rl2, rl1)) >= self.db_prom)
        reg_bear, hid_bear, dt_bear = (v_hi and ph_2 > ph_1 and rh2 < rh1), (v_hi and ph_2 < ph_1 and rh2 > rh1), (v_hi and abs(rh2 - rh1) <= self.db_tol and (min(rh2, rh1) - mid_lo) >= self.db_prom)
        m5_bull, m5_bear = ((reg_bull or hid_bull or db_bull) and r[1] > e9[1] and r[2] <= e9[2]), ((reg_bear or hid_bear or dt_bear) and r[1] < e9[1] and r[2] >= e9[2])
        w_up, w_dn = ((kl_orig > kh > k_hl >= 2) and (2 <= k_tch_up < kh) and not inv_up and (self.low[1] >= p_hl > pl_orig)), ((kh_orig > kl > k_lh >= 2) and (2 <= k_tch_dn < kl) and not inv_dn and (self.high[1] <= p_lh < ph_orig))
        ev_up = (self.close[1] > dh[1] and self.close[1] > self.open[1] and (self.close[2] <= dh[2] or self.low[2] <= dh[2])) if self.trig_mode == 0 else (self.close[1] > ph and self.close[2] <= ph)
        ev_dn = (self.close[1] < dl[1] and self.close[1] < self.open[1] and (self.close[2] >= dl[2] or self.high[2] >= dl[2])) if self.trig_mode == 0 else (self.close[1] < pl and self.close[2] >= pl)
        cyc_u, cyc_d = ((self.bar_index - kh > self.lock_u_bar) and (math.isnan(self.lock_ph) or ph >= self.lock_ph)), ((self.bar_index - kl > self.lock_d_bar) and (math.isnan(self.lock_pl) or pl <= self.lock_pl))
        fire_up, fire_dn = (b4_up and b1_up and m15_up and cyc_u and dc[1] > e89[1] and dc[1] > dc[2] and (not self.use_e200 or self.close[1] > e200[1]) and w_up and ev_up and m5_bull), (b4_dn and b1_dn and m15_dn and cyc_d and dc[1] < e89[1] and dc[1] < dc[2] and (not self.use_e200 or self.close[1] < e200[1]) and w_dn and ev_dn and m5_bear)
        self.lock_u_bar, self.lock_ph, self.lock_d_bar, self.lock_pl = (self.bar_index if fire_up else self.lock_u_bar), (ph if fire_up else self.lock_ph), (self.bar_index if fire_dn else self.lock_d_bar), (pl if fire_dn else self.lock_pl)
        return dh[0], dc[0], dl[0], e89[0], e200[0], (ref_ph if k_rph != 2 else math.nan), (ref_pl if k_rpl != 2 else math.nan), rnd_h, rnd_l, plot.Marker((self.low[1] - atr[1] * 0.25) if fire_up else math.nan, text='▲', offset=-1), plot.Marker((self.high[1] + atr[1] * 0.25) if fire_dn else math.nan, text='▼', offset=-1)
